# Это тестовые данные, одноразовые, их нет смысла воровать. Да, переменные окружения хранить в гите плохо ;)
URL_LOCAL_DOCKER_REPO=localhost:5001/
# --- СЕТЬ ---
SUBNET=currency-net

# --- БАЗА ДАННЫХ ---
DB_TYPE = "sqlite"
DB_IMAGE_NAME=my_maria_image
DB_IMAGE_TAG=1.0.0
DB_HOST=mariadb-server
DB_NAME=currency_db
DB_USER=app_user
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=admin_pass
DB_PATH=./MariaDB


# --- ADMIN ---
PMA_IMAGE_NAME=phpmyadmin_image
PMA_IMAGE_TAG=1.0.0
PMA_PORT=8081
PMA_PATH=./PHP_My_Admin

# --- PYTHON SERVER ---
PY_IMAGE_NAME=python_http_server
PY_IMAGE_TAG=1.0.0
PY_APP_PORT=8002